<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- Center icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Splash screen duration (optional) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Bottom branding image (API 31+) -->
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_branding</item>
        <!-- Post-splash theme (the main app theme) -->
        <item name="postSplashScreenTheme">@style/Theme.PhotoReport</item>
    </style>
</resources>
