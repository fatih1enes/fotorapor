<resources >
    <!-- Base application theme. -->
    <style name="Theme.PhotoReport" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color (Brass). -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen Theme (Android 12+) - Dark Mode -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen — sıcak karbon-siyahı -->
        <item name="windowSplashScreenBackground">#121009</item>
        <!-- Center icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Splash screen duration (optional) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Post-splash theme (the main app theme) -->
        <item name="postSplashScreenTheme">@style/Theme.PhotoReport</item>
    </style>
</resources>
