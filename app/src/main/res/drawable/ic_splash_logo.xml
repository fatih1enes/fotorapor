<?xml version="1.0" encoding="utf-8"?>
<!--
  FotoRapor Splash Logomark — Minimal System Splash variant.
  Sistem splash ekranında sadece küçük bir brass odak noktası gösterir.
  Karanlık splash arka planıyla uyum sağlar, sinematik launch
  animasyonuna kesintisiz geçiş yapar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Brass focus point — subtle warm marker -->
    <path
        android:fillColor="#D2A25C"
        android:fillAlpha="0.5"
        android:pathData="M 144 144 m -7 0 a 7,7 0 1 0 14 0 a 7,7 0 1 0 -14 0" />

</vector>
