# Example keystore properties file for local builds.
# Rename this file to 'keystore.properties' and fill in your actual keystore details.
# DO NOT commit your actual keystore.properties file or your .jks file to Git!

storeFile=release.jks
storePassword=your_store_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here
